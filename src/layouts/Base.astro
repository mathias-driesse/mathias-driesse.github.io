---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = "Mathias Driesse",
  description = "Mathias Driesse — PhD student in theoretical physics at Humboldt-Universität zu Berlin, working on gravitational wave physics from a worldline quantum field theory.",
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { href: "/", label: "About" },
  { href: "/news", label: "News" },
  { href: "/publications", label: "Publications" },
  { href: "/blog", label: "Blog" },
  { href: "/cv", label: "CV" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,300;8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Primary">
        <a href="/" class="nav-brand">Mathias Driesse</a>
        <div class="nav-links">
          {
            navItems.map((item) => {
              const current =
                item.href === "/"
                  ? pathname === "/"
                  : pathname === item.href || pathname.startsWith(item.href + "/");
              return (
                <a href={item.href} aria-current={current ? "page" : undefined}>
                  {item.label}
                </a>
              );
            })
          }
          <button
            class="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            id="theme-toggle"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main>
      <div class={wide ? "container-wide" : "container"}>
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div>
        © {new Date().getFullYear()} Mathias Driesse · Built with
        <a href="https://astro.build">Astro</a>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById("theme-toggle");
      if (btn) {
        btn.addEventListener("click", () => {
          const current =
            document.documentElement.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (_) {}
        });
      }
    </script>
  </body>
</html>
