---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PublicationItem from "../components/PublicationItem.astro";

const newsAll = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentNews = newsAll.slice(0, 3);

const pubsAll = await getCollection("publications");
const selectedPubs = pubsAll
  .filter((p) => p.data.selected)
  .sort((a, b) => {
    const ay = a.data.year * 100 + (a.data.month ?? 0);
    const by = b.data.year * 100 + (b.data.month ?? 0);
    return by - ay;
  });

const monthName = (m: number) =>
  ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m - 1];

const formatDate = (d: Date) =>
  `${monthName(d.getUTCMonth() + 1)} ${d.getUTCFullYear()}`;

// Pre-render news bodies
const renderedNews = await Promise.all(
  recentNews.map(async (n) => {
    const { Content } = await render(n);
    return { entry: n, Content };
  }),
);
---

<Base>
  <section class="hero">
    <div>
      <h1>Mathias Driesse</h1>

      <p>
        I'm Mathias, and I'm a PhD student in theoretical physics with the 
          <a href="https://qft.physik.hu-berlin.de/plefka-group/">
            Plefka group, Humboldt-Universität zu Berlin
          </a> at Humboldt-Universität zu Berlin. I mainly work on gravitational wave physics, but by importing tools from quantum field theory to solve my problems. Previously, I was at the University of Edinburgh and Caltech.
      </p>
      <p>
        I also work on machine learning for physics,
          <a href="https://www.youtube.com/@NonStandardModels">
            outreach
          </a>, and in my spare time love hiking, running, 
          <a href="https://www.instagram.com/berli.cious/">
            cooking and photography
          </a>, bouldering, reading, surfing, and films.
      </p>
    </div>

    <div class="hero-photo-wrap">
      <img
        class="hero-photo"
        src="/pic.jpg"
        alt="Mathias Driesse"
        width="240"
        height="240"
        loading="eager"
      />
      <a href="#contact" class="hero-contact-link">Contact me →</a>
    </div>
  </section>

  <section class="section" id="news">
    <div class="section-head">
      <h2>News</h2>
      <a href="/news">All news →</a>
    </div>
    <ul class="news-list">
      {
        renderedNews.map(({ entry, Content }) => (
          <li class="news-item">
            <div class="news-date">
              {entry.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })}
            </div>
            <div class="news-body">
              <Content />
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" id="selected-publications">
    <div class="section-head">
      <h2>Selected publications</h2>
      <a href="/publications">All publications →</a>
    </div>
    <ul class="pub-list">
      {selectedPubs.map((p) => <PublicationItem pub={p} />)}
    </ul>
  </section>

  <section class="section" id="contact">
    <div class="section-head">
      <h2>Contact</h2>
    </div>
    <dl class="contact-grid">
      <dt>Email</dt>
      <dd>
        <a href="mailto:mathias.driesse@physik.hu-berlin.de"
          >mathias.driesse@physik.hu-berlin.de</a
        >
      </dd>
      <dt>Office</dt>
      <dd>Office 1.219, IRIS Adlershof<br />Zum Großen Windkanal 2, 12489 Berlin</dd>
      <dt>InspireHEP</dt>
      <dd>
        <a href="https://inspirehep.net/authors/2768322?ui-citation-summary=true"
          >https://inspirehep.net/authors/2768322</a
        >
      </dd>
      <dt>ORCID</dt>
      <dd>
        <a href="https://orcid.org/0000-0002-3983-5852">https://orcid.org/0000-0002-3983-5852</a>
      </dd>
    </dl>
  </section>
</Base>
